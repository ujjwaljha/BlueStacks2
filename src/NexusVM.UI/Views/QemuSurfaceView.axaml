<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexusVM.UI.Views.QemuSurfaceView"
             ClipToBounds="True"
             Background="#090B0E">
  <Grid>
    <ContentControl x:Name="NativeSlot" />
    <Image x:Name="FrameImage"
           Stretch="Uniform"
           IsVisible="False" />
    <Border x:Name="Placeholder" Background="#101216">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8"
                  Margin="28"
                  MaxWidth="520">
        <TextBlock x:Name="PlaceholderTitle"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="Guest surface" />
        <TextBlock x:Name="PlaceholderBody"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Opacity="0.78"
                   Text="The guest window or framebuffer is attached here after launch." />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
