<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:BlueStacks2.App.Views"
        x:Class="BlueStacks2.App.Views.DiagnosticWindow"
        x:DataType="views:DiagnosticPresentation"
        Title="Host diagnostic"
        Width="680"
        Height="520"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid RowDefinitions="*,Auto" Margin="24">
    <ScrollViewer>
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock Classes="section" Text="What happened" />
        <TextBox Text="{Binding Summary, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True" />
        <TextBlock Classes="section" Text="What to do" />
        <TextBox Text="{Binding Remediation, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 MinHeight="96" />
        <TextBlock Classes="section" Text="Details" IsVisible="{Binding HasDetails}" />
        <ItemsControl ItemsSource="{Binding Details}" IsVisible="{Binding HasDetails}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:CompileBindings="False">
              <TextBlock Text="{Binding}"
                         FontFamily="Cascadia Mono,DejaVu Sans Mono,Menlo,monospace"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Margin="0,0,0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Button Grid.Row="1"
            Content="Close"
            HorizontalAlignment="Right"
            Margin="0,16,0,0"
            Padding="18,8"
            Click="OnClose" />
  </Grid>
</Window>
